LOG_LEVEL=warning

POSTGRES_USER=calendar
POSTGRES_PASSWORD=change-me # run `openssl rand -hex 24`
POSTGRES_DB=calendar_manager

SESSION_SECRET=replace-with-a-long-random-secret # run `openssl rand -hex 24`
BASE_URL=http://localhost:8000

# Disable OAuth authentication. All users access the same dummy user and see
# the same imports, exports and boards.
SKIP_AUTHENTICATION=false

# Leave a provider's credentials blank to disable it. At least one must
# be configured for anybody to be able to sign in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=
POCKETID_SERVER_METADATA_URL=

# Daily cleanup time of day in UTC (HH:MM)
CLEANUP_TIME=03:00

# Backoff after the 1st, 2nd, 3rd ... consecutive failed fetch of a web calendar.
# ISO 8601 durations as a JSON list. The last entry repeats. PT0S means retry on the next refresh.
FETCH_BACKOFF_DURATIONS='["PT0S","PT0S","PT1H","PT6H","PT12H","PT24H","PT36H"]'

# Backup retention tiers as [max_age, keep_interval], youngest first. null = unbounded (last tier only).
# 0-3 days: daily, 3-14 days: weekly, 14 days-1 year: every 30 days, older: yearly forever
RETENTION_TIERS='[["P3D","P1D"],["P14D","P1W"],["P1Y","P30D"],[null,"P1Y"]]'

# Share of a keep interval a gap may fall short of and still count (0 <= ratio < 1)
RELATIVE_RETENTION_INTERVAL_TOLERANCE=0.1
